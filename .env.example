# Copy to .env for local development: cp .env.example .env
# None of these are needed on ECS; the task definition sets APP_ENV and PORT,
# and the image sets APP_VERSION at build time.

# Lab: shown on every page
STUDENT_NAME=Your Full Name
APP_ENV=local
APP_VERSION=local

# Django
# SECRET_KEY is optional: nothing is signed today (no sessions or login).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Production only: turn on once an HTTPS listener is in front of the service.
# USE_HTTPS=False

# Docker Compose: host port for the web container
WEB_PORT=8000
